# /etc/network/interfaces - template file
# Generated by Ansible

# The loopback network interface
auto lo
iface lo inet loopback

# The primary network interface
auto {{ interface }}
iface {{ interface }} inet manual
    # No IP on the main interface

# WAN interface (VLAN 10)
auto {{ interface }}.{{ wan.vlan }}
iface {{ interface }}.{{ wan.vlan }} inet static
    address {{ wan.address }}
    netmask {{ wan.netmask }}
    gateway {{ wan.gateway }}
    # Google DNS servers
    dns-nameservers 8.8.8.8 8.8.4.4

# LAN1 interface (VLAN 20)
auto {{ interface }}.{{ lan1.vlan }}
iface {{ interface }}.{{ lan1.vlan }} inet static
    address {{ lan1.address }}
    netmask {{ lan1.netmask }}

# LAN2 interface (VLAN 30)
auto {{ interface }}.{{ lan2.vlan }}
iface {{ interface }}.{{ lan2.vlan }} inet static
    address {{ lan2.address }}
    netmask {{ lan2.netmask }}
