# /etc/network/interfaces - template file
# Generated by Ansible

# The loopback network interface
auto lo
iface lo inet loopback

# The primary network interface
auto {{ interface }}
iface {{ interface }} inet manual
    # No IP on the main interface
    up ip link set $IFACE up
    down ip link set $IFACE down

# WAN interface (VLAN 10)
auto {{ interface }}.{{ wan.vlan }}
iface {{ interface }}.{{ wan.vlan }} inet static
    address {{ wan.ip }}
    netmask {{ wan.netmask }}
    gateway {{ wan.gateway }}
    vlan-raw-device {{ interface }}
{% for route in additional_routes %}
{% if route.vlan == "wan" %}
    post-up ip route add {{ route.network }}/{{ route.cidr }} via {{ route.gateway }}
    pre-down ip route del {{ route.network }}/{{ route.cidr }} via {{ route.gateway }}
{% endif %}
{% endfor %}

# LAN interface (VLAN 20) 
auto {{ interface }}.{{ lan.vlan }}
iface {{ interface }}.{{ lan.vlan }} inet static
    address {{ lan.ip }}
    netmask {{ lan.netmask }}
    vlan-raw-device {{ interface }}
{% for route in additional_routes %}
{% if route.vlan == "lan" %}
    post-up ip route add {{ route.network }}/{{ route.cidr }} via {{ route.gateway }}
    pre-down ip route del {{ route.network }}/{{ route.cidr }} via {{ route.gateway }}
{% endif %}
{% endfor %}
