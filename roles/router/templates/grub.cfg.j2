set timeout=10
set default=0

menuentry "Boot from local disk" {
    set root=(hd0)
    chainloader /EFI/BOOT/BOOTX64.EFI
}

{% if pxe.debian.enabled | default(false) %}
menuentry "Install Debian {{ pxe.debian.version }} ({{ pxe.debian.arch }})" {
    linux /debian/vmlinuz vga=788 modprobe.blacklist=iwlwifi --- quiet
    initrd /debian/initrd.gz
}

menuentry "Install Debian {{ pxe.debian.version }} ({{ pxe.debian.arch }}) - Preseed" {
    linux /debian/vmlinuz vga=788 auto=true priority=critical url=tftp://{{ lan1.address }}/debian/preseed/preseed.cfg netcfg/choose_interface=auto modprobe.blacklist=iwlwifi --- quiet
    initrd /debian/initrd.gz
}
{% endif %}
